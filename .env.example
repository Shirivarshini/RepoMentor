# RepoMentor environment configuration.
# Copy to `.env` (never commit it). Only variables that are actually used are listed;
# more are added by the phase that first needs them.

# --- Backend ---------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Comma-separated list of allowed browser origins. '*' is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (docker compose) --------------------------------------------
# Used by the `db` service, and by Compose to build the backend's DATABASE_URL.
# Development-only defaults; use a URL-safe password.
POSTGRES_USER=repomentor
POSTGRES_PASSWORD=repomentor
POSTGRES_DB=repomentor

# --- Backend outside Docker --------------------------------------------------
# Only needed when running the backend directly on the host (see README). Docker Compose
# builds its own DATABASE_URL (host `db`) from the POSTGRES_* values above.
DATABASE_URL=postgresql+asyncpg://repomentor:repomentor@localhost:5432/repomentor

# --- Frontend ----------------------------------------------------------------
# Leave empty to call the API on the same origin (the dev server proxies /api and /health).
VITE_API_BASE_URL=

# Host ports. Set BACKEND_PORT=8001 if another project occupies 8000.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional GitHub token increases the public API quota; private repositories remain blocked.
GITHUB_TOKEN=
# Required for embeddings and repository Q&A. Structural analysis works without this.
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-flash-lite-latest
EMBEDDING_MODEL=gemini-embedding-001

# Backend defaults (set as backend environment variables to override).
GITHUB_HTTP_TIMEOUT_SECONDS=15
MAX_TREE_ENTRIES=50000
MAX_ANALYZED_FILES=500
MAX_FILE_SIZE_BYTES=200000
MAX_CHUNKS_PER_REPOSITORY=5000
MAX_CHUNK_TOKENS=800
MAX_CONCURRENT_ANALYSES=2
RETRIEVAL_MIN_SIMILARITY=0.45
RATE_LIMIT_ANALYZE=10
RATE_LIMIT_ASK=10
RATE_LIMIT_READ=240
